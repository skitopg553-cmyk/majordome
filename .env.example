# Copier ce fichier en .env.local (en local) et remplir les mêmes variables dans Vercel.
# Ne JAMAIS commiter les vraies valeurs, ni les coller dans un chat.

# Fournisseur IA : "openai" (crédits restants) ou "anthropic" (cible)
AI_PROVIDER=openai

# --- Si AI_PROVIDER=openai ---
OPENAI_API_KEY=
OPENAI_MODEL=              # modèle principal (le même que sur Lokyn, par ex.)
OPENAI_MODEL_SMALL=        # optionnel : modèle bon marché pour les petites tâches
OPENAI_PRICE_INPUT_PER_MTOK=   # optionnel : prix en $ / million de tokens, pour le suivi des coûts
OPENAI_PRICE_OUTPUT_PER_MTOK=

# --- Si AI_PROVIDER=anthropic ---
ANTHROPIC_API_KEY=

# Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Code d'accès personnel (phase 0) : une longue phrase que toi seul connais
MAJORDOME_ACCESS_CODE=

# Voix ElevenLabs (serveur seulement) : sans elles, la voix passe par OpenAI puis par le téléphone
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# flash | v2 | v3 (défaut flash) ; prix du crédit pour l estimation de coût (défaut 0.20 $ les 1000 crédits)
ELEVENLABS_MODEL=
ELEVENLABS_USD_PER_1K_CREDITS=
